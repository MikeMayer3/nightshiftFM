; M2 gray-box combat. Engine pin: tools/engine-version.txt.
config_version=5

[application]
config/name="Nightshift FM — M2"
config/version="0.2.0"
config/icon="res://assets/art/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="NightshiftFM"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input]
menu_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":80)]
}
focus_target={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
aim_override={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
shield_ability={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[input_devices]
pointing/emulate_mouse_from_touch=true

[internationalization]
locale/translations=PackedStringArray("res://assets/ui_strings.en.translation")
locale/fallback="en"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
